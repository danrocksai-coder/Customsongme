# HTML pages (always fresh)
/*
  Cache-Control: no-cache

# Utility pages (not indexed)
/thanks
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/thanks-rescue
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/es/gracias
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/es/gracias/
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/payment-links
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/oxnard/93030
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/oxnard/93030/intake
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/oxnard/intake.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/oxnard/93030/advertise
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/oxnard/93030/advertise.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# Sitemap & robots
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

# Images (long cache)
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.gif
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

# CSS & JS (long cache)
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/landscapers
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# Private customer song pages (never in search results)
/songs/*
  X-Robots-Tag: noindex, follow
  Cache-Control: no-cache

# Reverse Gift: product page and personal QR pages are never in search results.
# Noindex is not privacy: anyone with a page link can still open it.
/reverse-gift
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache
  Referrer-Policy: no-referrer

/reverse-gift/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
